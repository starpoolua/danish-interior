    window.addEventListener('load', function() {

        var replyButtons = document.querySelectorAll('.reply-btn');

        if (!replyButtons) return;

        [].slice.call(replyButtons).forEach(function(replyButton) {
            replyButton.addEventListener('click', replyButtonClickHandler);
        });

        function replyButtonClickHandler(e) {
            e.preventDefault();
            var replyForm = this.parentNode.parentNode.querySelector('.reply-form')
            toggleClass(replyForm, 'hidden');
            var body = replyForm.querySelector('#reply_body');
            if (body) body.focus();
        }

        function toggleClass(el, $class) {
            if (el.classList.contains($class)) {
                return el.classList.remove($class);
            }
            el.classList.add($class);
        }


        [].slice.call(document.querySelectorAll('.delete-btn')).forEach(function(button) {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                var n = new Noty({
