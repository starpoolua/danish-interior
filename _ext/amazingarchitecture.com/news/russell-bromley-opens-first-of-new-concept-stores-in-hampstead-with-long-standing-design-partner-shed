                            'data-status': 'ok'
                        }),

                        Noty.button('Cancel', 'btn', function() {
                            n.close();
                        })
                    ]
                });

                n.show();
            })
        });

        //Edit
        [].slice.call(document.querySelectorAll('.edit-btn')).forEach(function(button) {
            button.addEventListener('click', editClickHandler);
        })

        function editClickHandler(e) {
            e.preventDefault();
            var targetClass = this.getAttribute('data-target');
            var target = document.querySelector(targetClass);
            var form = target.querySelector('.edit-form');

            target.querySelector('.btn-cancel').addEventListener('click', function(e) {
                e.preventDefault();
                form.classList.add('hidden');
            });

            form.classList.remove('hidden');
            form.querySelector('textarea').focus()
        }

    })
