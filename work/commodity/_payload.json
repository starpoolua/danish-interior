commodity-01.jpg?dpr=0.75&fit=crop&w=3200 2400w,https://www.datocms-assets.com/133654/1757075953-shed-commodity-01.jpg?fit=crop&w=3200 3200w","https://www.datocms-assets.com/133654/1757075953-shed-commodity-01.jpg?fit=crop&w=3200","(max-width: 3200px) 100vw, 3200px","NYC, USA",[46,49],{"slug":47,"label":48},"beauty","Beauty",{"slug":50,"label":51},"retail","Retail","Design, Strategy, Packaging Design, Interior Design","\u003Cp>\u003Cspan data-metadata=\"&lt;!--(figmeta)eyJmaWxlS2V5IjoiWGJVSFVxeUc3bjVjOHRLZjg4NzJVdyIsInBhc3RlSUQiOjEwNzAxMzIxODgsImRhdGFUeXBlIjoic2NlbmUifQo=(/figmeta)--&gt;\">\u003C/span>\u003Cspan>Commodity is a brand that strips away the clich&eacute;s and looks to make fragrance more accessible to all. Shed helped them to imagine their flagship store and design their main touchpoints.\u003C/span>\u003C/p>",[55,58,61],{"title":56,"copy":57},"The Challenge","\u003Cp>\u003Cspan data-metadata=\"&lt;!--(figmeta)eyJmaWxlS2V5IjoiWGJVSFVxeUc3bjVjOHRLZjg4NzJVdyIsInBhc3RlSUQiOjY1MzM1NjE1NCwiZGF0YVR5cGUiOiJzY2VuZSJ9Cg==(/figmeta)--&gt;\">\u003C/span>\u003Cspan>How can a fragrance brand feel premium while remaining accessible? Unlike traditional perfumes that rely on French terminology, Commodity modernises fragrance and simplifies the language around it.\u003C/span>\u003C/p>",{"title":59,"copy":60},"The Strategy","\u003Cp>\u003Cspan data-metadata=\"&lt;!--(figmeta)eyJmaWxlS2V5IjoiWGJVSFVxeUc3bjVjOHRLZjg4NzJVdyIsInBhc3RlSUQiOjc1OTI3MzY5NywiZGF0YVR5cGUiOiJzY2VuZSJ9Cg==(/figmeta)--&gt;\">\u003C/span>\u003Cspan>Rooted in elemental design and a modern approach, they are the guiding principles that help communicate the Commodity ethos, making the exceptional accessible.\u003C/span>\u003C/p>",{"title":62,"copy":63},"The Solution","\u003Cp>\u003Cspan data-metadata=\"&lt;!--(figmeta)eyJmaWxlS2V5IjoiWGJVSFVxeUc3bjVjOHRLZjg4NzJVdyIsInBhc3RlSUQiOjEzNDU5NjkwNDQsImRhdGFUeXBlIjoic2NlbmUifQo=(/figmeta)--&gt;\">\u003C/span>\u003Cspan>By maintaining a consistent aesthetic across product ranges and retail environments, every touchpoint feels uniquely Commodity, blending elemental minimalism with artistic expression.\u003C/span>\u003C/p>",[65,68,80],{"isVideo":66,"videoHeight":31,"videoUrl":67,"videoWidth":33,"image":38},true,"https://player.vimeo.com/progressive_redirect/playback/1116178221/rendition/1080p/file.mp4?loc=external&signature=6a05227e2f146f5d7be01146c2e1ff3d806141dbbbad57577e4f490b6c83b770",{"isVideo":10,"videoHeight":31,"videoUrl":32,"videoWidth":33,"image":69},{"width":70,"height":71,"url":72,"alt":38,"title":38,"responsiveImage":73},1034,686,"https://www.datocms-assets.com/133654/1757077185-shed-commodity-03.jpg",{"webpSrcSet":74,"srcSet":75,"src":76,"width":77,"height":78,"sizes":79},"https://www.datocms-assets.com/133654/1757077185-shed-commodity-03.jpg?dpr=0.25&fit=crop&fm=webp&w=2094 523w,https://www.datocms-assets.com/133654/1757077185-shed-commodity-03.jpg?fit=crop&fm=webp&w=2094 2094w","https://www.datocms-assets.com/133654/1757077185-shed-commodity-03.jpg?dpr=0.25&fit=crop&w=2094 523w,https://www.datocms-assets.com/133654/1757077185-shed-commodity-03.jpg?fit=crop&w=2094 2094w","https://www.datocms-assets.com/133654/1757077185-shed-commodity-03.jpg?fit=crop&w=2094",2094,1389,"(max-width: 2094px) 100vw, 2094px",{"isVideo":10,"videoHeight":31,"videoUrl":32,"videoWidth":33,"image":81},{"width":70,"height":71,"url":82,"alt":38,"title":38,"responsiveImage":83},"https://www.datocms-assets.com/133654/1757077261-shed-commodity-04.jpg",{"webpSrcSet":84,"srcSet":85,"src":86,"width":77,"height":78,"sizes":79},"https://www.datocms-assets.com/133654/1757077261-shed-commodity-04.jpg?dpr=0.25&fit=crop&fm=webp&w=2094 523w,https://www.datocms-assets.com/133654/1757077261-shed-commodity-04.jpg?fit=crop&fm=webp&w=2094 2094w","https://www.datocms-assets.com/133654/1757077261-shed-commodity-04.jpg?dpr=0.25&fit=crop&w=2094 523w,https://www.datocms-assets.com/133654/1757077261-shed-commodity-04.jpg?fit=crop&w=2094 2094w","https://www.datocms-assets.com/133654/1757077261-shed-commodity-04.jpg?fit=crop&w=2094",[88,93,109,121,176,184,189,193,204,208,226,235,239,252,260],{"_modelApiKey":89,"title":90,"sideCopy":91,"mainCopy":92},"module_title_copy","SCENT SPACE","\u003Cp>\u003Cspan data-metadata=\"&lt;!--(figmeta)eyJmaWxlS2V5IjoiWGJVSFVxeUc3bjVjOHRLZjg4NzJVdyIsInBhc3RlSUQiOjE2NTAwMzA0NTIsImRhdGFUeXBlIjoic2NlbmUifQo=(/figmeta)--&gt;\">\u003C/span>\u003Cspan>Each core Commodity fragrance is available in three different intensities: Personal, Expressive and Bold, allowing customers to take control of their scent&rsquo;s projection.\u003C/span>\u003C/p>","\u003Cp>\u003Cspan data-metadata=\"&lt;!--(figmeta)eyJmaWxlS2V5IjoiWGJVSFVxeUc3bjVjOHRLZjg4NzJVdyIsInBhc3RlSUQiOjYyMTUxNjQ4NiwiZGF0YVR5cGUiOiJzY2VuZSJ9Cg==(/figmeta)--&gt;\">\u003C/span>\u003Cspan>The design language is stripped back to its minimal essence, using basic symbols and familiar visual cues to communicate ideas intuitively &mdash; allowing the audience to grasp the concept effortlessly.\u003C/span>\u003C/p>",{"_modelApiKey":94,"assets":95},"module_side_by_side",[96,98],{"isVideo":66,"videoHeight":31,"videoUrl":97,"videoWidth":33,"image":38},"https://player.vimeo.com/progressive_redirect/playback/1116178255/rendition/1080p/file.mp4?loc=external&signature=87333e4c65b6c221404da4606f8c2a4df2a359e8bb930b47466e952db9aa2652",{"isVideo":10,"videoHeight":31,"videoUrl":32,"videoWidth":33,"image":99},{"width":100,"height":101,"url":102,"alt":38,"title":38,"responsiveImage":103},1566,1990,"https://www.datocms-assets.com/133654/1757080916-shed-commodity-05.jpg",{"webpSrcSet":104,"srcSet":105,"src":106,"width":33,"height":107,"sizes":108},"https://www.datocms-assets.com/133654/1757080916-shed-commodity-05.jpg?dpr=0.25&fit=crop&fm=webp&w=1600 400w,https://www.datocms-assets.com/133654/1757080916-shed-commodity-05.jpg?dpr=0.5&fit=crop&fm=webp&w=1600 800w,https://www.datocms-assets.com/133654/1757080916-shed-commodity-05.jpg?dpr=0.75&fit=crop&fm=webp&w=1600 1200w,