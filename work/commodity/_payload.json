 twist.\u003C/span>\u003C/div>","\u003Cp>\u003Cspan>Developing the brand architecture naturally led to imagining Commodity&rsquo;s first flagship in New York. Our collaboration with RDK Architect added depth, helping translate the brand&rsquo;s DNA into a space that feels immersive.\u003C/span>\u003C/p>",{"_modelApiKey":122,"assetPosition":240,"isWide":10,"assets":241},"left",[242],{"copy":32,"asset":243},{"isVideo":10,"videoHeight":31,"videoUrl":32,"videoWidth":33,"image":244},{"width":77,"height":245,"url":246,"alt":38,"title":38,"responsiveImage":247},2070,"https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg",{"webpSrcSet":248,"srcSet":249,"src":250,"width":128,"height":251,"sizes":135},"https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?dpr=0.25&fit=crop&fm=webp&w=1740 435w,https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?dpr=0.5&fit=crop&fm=webp&w=1740 870w,https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?dpr=0.75&fit=crop&fm=webp&w=1740 1305w,https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?fit=crop&fm=webp&w=1740 1740w","https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?dpr=0.25&fit=crop&w=1740 435w,https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?dpr=0.5&fit=crop&w=1740 870w,https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?dpr=0.75&fit=crop&w=1740 1305w,https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?fit=crop&w=1740 1740w","https://www.datocms-assets.com/133654/1757082799-shed-commodity-14.jpg?fit=crop&w=1740",1720,{"_modelApiKey":110,"asset":253},{"isVideo":10,"videoHeight":31,"videoUrl":32,"videoWidth":33,"image":254},{"width":113,"height":114,"url":255,"alt":38,"title":38,"responsiveImage":256},"https://www.datocms-assets.com/133654/1757082746-shed-commodity-15.jpg",{"webpSrcSet":257,"srcSet":258,"src":259,"width":35,"height":120,"sizes":43},"https://www.datocms-ass