93,"quote":94,"author":95},"module_quote","“A Stand that’s always successful, inviting  with strong brand presence”","JULIAN ASH, Barbour",{"_modelApiKey":97,"assets":98},"module_side_by_side",[99,110],{"isVideo":9,"videoHeight":30,"videoUrl":31,"videoWidth":32,"image":100},{"width":101,"height":102,"url":103,"alt":7,"title":7,"responsiveImage":104},1564,1990,"https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg",{"webpSrcSet":105,"srcSet":106,"src":107,"width":32,"height":108,"sizes":109},"https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?dpr=0.25&fit=crop&fm=webp&w=1600 400w,https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?dpr=0.5&fit=crop&fm=webp&w=1600 800w,https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?dpr=0.75&fit=crop&fm=webp&w=1600 1200w,https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?fit=crop&fm=webp&w=1600 1600w","https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?dpr=0.25&fit=crop&w=1600 400w,https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?dpr=0.5&fit=crop&w=1600 800w,https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?dpr=0.75&fit=crop&w=1600 1200w,https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?fit=crop&w=1600 1600w","https://www.datocms-assets.com/133654/1738938214-mg_1576.jpg?fit=crop&w=1600",2036,"(max-width: 1600px) 100vw, 1600px",{"isVideo":9,"videoHeight":30,"videoUrl":31,"videoWidth":32,"image":111},{"width":101,"height":102,"url":112,"alt":7,"title":7,"responsiveImage":113},"https://www.datocms-assets.com/133654/1738938245-barbour-and-the-royal-warrants-2.jpg",{"webpSrcSet":114,"srcSet":115,"src":116,"width":32,"height":108,"sizes":109},"https://www.datocms-assets.com/133654/1738938245-barbour-and-the-royal-warrants-2.jpg?dpr=0.25&fit=crop&fm=webp&w=1600 400w,https://www.datocms-assets.com/133654/1738938245-barbour-and-the-royal-warrants-2.jpg?dpr=0.5&fit=crop&fm=webp&w=1600 800w,https://www.datocms-assets.com/133654/1738938245-barbour-and-the-